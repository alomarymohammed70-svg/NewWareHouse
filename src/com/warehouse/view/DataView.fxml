<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8" 
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.warehouse.view.DataViewController" 
      stylesheets="@styles.css" fx:id="mainContainer">
    
   
   <children>
      <Label fx:id="titleLabel" styleClass="label-main-title" text="البيانات" />
      
      <TextArea fx:id="dataTextArea" editable="false" prefHeight="400.0" prefWidth="700.0" 
                wrapText="true" styleClass="text-area" />
      
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handlePrint" styleClass="button-print" text="🖨️ طباعة" />
            <Button mnemonicParsing="false" onAction="#handleClose" styleClass="button-delete" text="❌ إغلاق" />
         </children>
      </HBox>
   </children>
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   
</VBox>